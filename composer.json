{
    "name": "t3sbs/t3sbootstrap",
    "description": "Bootstrap Components - Startup extension to use Bootstrap 5 classes, components and more out of the box.",
    "keywords": [
        "typo3",
        "typo3 cms",
        "bootstrap"
    ],
    "homepage": "https://t3sbootstrap.de",
    "authors": [
        {
            "name": "Helmut Hackbarth",
            "email": "info@t3solution.de",
            "role": "Developer"
        }
    ],
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "support": {
        "issues": "https://github.com/t3solution/t3sbootstrap/issues",
        "source": "https://github.com/t3solution/t3sbootstrap"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.3",
        "typo3/cms-rte-ckeditor": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3",
        "b13/container": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "T3SBS\\T3sbootstrap\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "t3sbootstrap",
            "version": "5.3.51",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}