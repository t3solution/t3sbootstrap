mod {
	web_layout {
		BackendLayouts {
			ThreeCol {
				title = LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:backend_layout.threeCol
				config {
					backend_layout {
						colCount = 3
						rowCount = 3
						rows {
							1 {
								columns {
									1 {
										name = LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:backend_layout.expanded_top
										colPos = 20
										colspan = 3
										identifier = ExpandedContentTop
									}
								}
							}
							2 {
								columns {
									1 {
										name = LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:backend_layout.sidebar-left
										colspan = 1
										colPos = 1
										identifier = Left
									}
									2 {
										name = LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:backend_layout.content
										colspan = 1
										colPos = 0
										identifier = Main
									}
									3 {
										name = LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:backend_layout.sidebar-right
										colspan = 1
										colPos = 2
										identifier = Right
									}
								}
							}
							3 {
								columns {
									1 {
										name =  LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:backend_layout.expanded_bottom
										colPos = 21
										colspan = 3
										identifier = ExpandedContentBottom
									}
								}
							}
						}
					}
				}
				icon = EXT:t3sbootstrap/Resources/Public/Icons/Layouts/layout-3_col-3-6-3_extra.svg
			}
		}
	}
}

