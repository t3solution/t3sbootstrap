mod {
	web_layout {
		BackendLayouts {
			TwoCol_9-3_Extra {
				title = 2 Columns (aside right) with extra rows (top and bottom)
				config {
					backend_layout {
						colCount = 2
						rowCount = 3
						rows {
							1 {
								columns {
									1 {
										name = Expanded Content Top
										colspan = 3
										colPos = 20
										identifier = ExpandedContentTop
									}
								}
							}
							2 {
								columns {
									1 {
										name = LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:backend_layout.content
										colspan = 2
										colPos = 0
										identifier = Main
									}
									2 {
										name = LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:backend_layout.sidebar
										colspan = 1
										colPos = 2
										identifier = Right
									}
								}
							}
							3 {
								columns {
									1 {
										name = Expanded Content Bottom
										colspan = 3
										colPos = 21
										identifier = ExpandedContentBottom
									}
								}
							}
						}
					}
				}
				icon = EXT:t3sbootstrap/Resources/Public/Icons/Layouts/layout-2_col-9-3_extra.svg
			}
		}
	}
}
