#-------------------------------------------------------------------------------
#	Pages
#-------------------------------------------------------------------------------
# No default for backend_layout on purpose: a preset value lands in the page's own
# field and beats "backend_layout_next_level" of every parent, so the inheritance a
# user sets there would never take effect. An unset field falls back to OneCol anyway.
TCAdefaults.pages.tx_t3sbootstrap_container = container
TCAdefaults.pages.tx_t3sbootstrap_smallColumns = 3

[tree.level in [2]]
[ELSE]
TCEFORM.pages.tx_t3sbootstrap_dropdownRight.disabled = 1
[END]

[traverse(page, "doktype") == 198]
TCEFORM.pages.subtitle.disabled = 1
TCEFORM.pages.nav_title.disabled = 1
TCEFORM.pages.crdate.disabled = 1
[END]
