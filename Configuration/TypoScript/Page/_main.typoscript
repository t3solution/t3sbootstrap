
@import 'EXT:t3sbootstrap/Configuration/TypoScript/Page/Configuration.typoscript'
@import 'EXT:t3sbootstrap/Configuration/TypoScript/Page/Register.typoscript'
@import 'EXT:t3sbootstrap/Configuration/TypoScript/Page/BodyTag.typoscript'
@import 'EXT:t3sbootstrap/Configuration/TypoScript/Page/Template.typoscript'

# EXT:t3sbootstrap default CSS
# --------------------------------------------------------------------------------------------------------------------------
page {
	includeCSS {
		t3sbootstrap = EXT:t3sbootstrap/Resources/Public/Styles/t3sbootstrap.css
		t3sbootstrap.if.isFalse = {$bootstrap.config.disableDefaultCss}

		t3sbFa = EXT:t3sbootstrap/Resources/Public/Styles/t3sb-fontawseome.css
		t3sbFa.if.isFalse = {$bootstrap.config.disableFaCss}
	}
}


# PRISM - syntax highlighting for the code blocks coming from the RTE
# --------------------------------------------------------------------------------------------------------------------------
# The RTE only writes <pre><code class="language-*">, a single text node no CSS can
# colour - Prism builds the token layer in the frontend. Setting: Extension
# Configuration > RTE > Code block (0 = none, 1 = no colouring, else a theme name);
# t3sbootstrapValue(), not t3sbootstrap(), which would normalise the themes to '1'.
[t3sbootstrapValue('rteCodeBlock') not in ['0', '1', '']]
	page.includeJSFooter.t3sbPrism = EXT:t3sbootstrap/Resources/Public/Prism/prism.js
[END]

# Je Theme nur noch das Stylesheet. Eine Bedingung kann nur schalten und nicht
# in den Pfad hineinschreiben, deshalb bleibt es bei einem Block pro Theme.

[t3sbootstrapValue('rteCodeBlock') == 'Default']
	page.includeCSS.t3sbPrism = EXT:t3sbootstrap/Resources/Public/Prism/Default.css
[END]

[t3sbootstrapValue('rteCodeBlock') == 'Dark']
	page.includeCSS.t3sbPrism = EXT:t3sbootstrap/Resources/Public/Prism/Dark.css
[END]

[t3sbootstrapValue('rteCodeBlock') == 'Coy']
	page.includeCSS.t3sbPrism = EXT:t3sbootstrap/Resources/Public/Prism/Coy.css
[END]

[t3sbootstrapValue('rteCodeBlock') == 'Funky']
	page.includeCSS.t3sbPrism = EXT:t3sbootstrap/Resources/Public/Prism/Funky.css
[END]

[t3sbootstrapValue('rteCodeBlock') == 'Okaidia']
	page.includeCSS.t3sbPrism = EXT:t3sbootstrap/Resources/Public/Prism/Okaidia.css
[END]

[t3sbootstrapValue('rteCodeBlock') == 'SolarizedLight']
	page.includeCSS.t3sbPrism = EXT:t3sbootstrap/Resources/Public/Prism/SolarizedLight.css
[END]

[t3sbootstrapValue('rteCodeBlock') == 'TomorrowNight']
	page.includeCSS.t3sbPrism = EXT:t3sbootstrap/Resources/Public/Prism/TomorrowNight.css
[END]

[t3sbootstrapValue('rteCodeBlock') == 'Twilight']
	page.includeCSS.t3sbPrism = EXT:t3sbootstrap/Resources/Public/Prism/Twilight.css
[END]


# BOOTSTRAP CSS & JS
# --------------------------------------------------------------------------------------------------------------------------
[traverse(site("configuration"), "settings/bootstrap/cdn/customScss") == false && traverse(site("configuration"), "settings/bootstrap/cdn/enable") == false]

	page {
		includeCSSLibs {
			bootstrapCSS = {$bootstrap.assetPath}T3SB-CSS/bootstrap.min.css	
		}
	}

	@import 'EXT:t3sbootstrap/Configuration/TypoScript/Page/IncludeLocalJs.typoscript'

[END]

# BOOTSTRAP JS
[traverse(site("configuration"), "settings/bootstrap/cdn/customScss") == true && traverse(site("configuration"), "settings/bootstrap/cdn/enable") == false]
	 @import 'EXT:t3sbootstrap/Configuration/TypoScript/Page/IncludeLocalJs.typoscript'
[END]


# Custom SCSS
# --------------------------------------------------------------------------------------------------------------------------
[traverse(site("configuration"), "settings/bootstrap/cdn/customScss") == true && traverse(site("configuration"), "settings/bootstrap/cdn/enable") == false]

	page {
		includeCSSLibs {
			bootstrapCustom = {$bootstrap.assetPath}T3SB-SCSS/Bootstrap/bootstrap-{$bootstrap.config.homepageUid}.scss
			bootstrapCustom.forceOnTop = 1
		}
	}

[END]


# External (CDN)
# --------------------------------------------------------------------------------------------------------------------------
[traverse(site("configuration"), "settings/bootstrap/cdn/customScss") == false && traverse(site("configuration"), "settings/bootstrap/cdn/enable") == true]
	@import 'EXT:t3sbootstrap/Configuration/TypoScript/Page/IncludeExternal.typoscript'
[END]


# google fonts
# --------------------------------------------------------------------------------------------------------------------------
[traverse(site("configuration"), "settings/bootstrap/cdn/googlefonts")]
	page {
		includeCSS {
			googleFontCSS = {$bootstrap.assetPath}T3SB-CSS/googlefonts.css
		}
	}
[END]


# jQuery
# A constant in a condition MUST be quoted. Site settings keep their PHP type, so a
# "type: bool" setting set to false substitutes as an empty string - unquoted that
# leaves "|| == 0", the condition fails to parse and the whole block is skipped.
# --------------------------------------------------------------------------------------------------------------------------
[traverse(site("configuration"), "settings/bootstrap/disable/jquery") == false || "{$bootstrap.disable.jquery}" == "0"]
	@import 'EXT:t3sbootstrap/Configuration/TypoScript/Page/jQuery.typoscript'
[END]


# Background Image
# --------------------------------------------------------------------------------------------------------------------------
["{$bootstrap.config.backgroundImageEnable}" == "1"]
page.cssInline {
	5 = TEXT
	5.value = body {background-repeat:no-repeat;background-position: center center;background-size: cover;background-attachment: fixed}
}
[END]


# DUPE (CDN)
# --------------------------------------------------------------------------------------------------------------------------
[traverse(site("configuration"), "settings/bootstrap/cdn/customScss") == true && traverse(site("configuration"), "settings/bootstrap/cdn/enable") == true]
	@import 'EXT:t3sbootstrap/Configuration/TypoScript/Page/IncludeExternal.typoscript'
[END]
