@import 'EXT:t3sbootstrap/Configuration/TypoScript/Content/Content.typoscript'

tt_content.stdWrap.prepend = TEXT
tt_content.stdWrap.prepend {
	field = tx_t3sbootstrap_anchor
	required = 1
	htmlSpecialChars = 1
	wrap = <span id="|" class="t3sbs-anchor"></span>
	# Nur eine Bedingung: das Element muss im Section-Index stehen.
	#
	# Die Extension-Option "Speaking ID" darf hier NICHT abgefragt werden. Sie
	# entscheidet ausschliesslich darueber, ob das Feld tx_t3sbootstrap_anchor
	# im Backend angeboten wird (siehe TCA/Overrides/tt_content_newCType.php).
	# Das Feld gibt es aber schon lange, und die Option ist neu und steht auf
	# aus - haenge das Rendern daran, verschwinden auf bestehenden Seiten alle
	# Anker-Spans, waehrend die Section-Menue-Links in der Navbar weiter darauf
	# zeigen. Genau das war in 5.3.51 kaputt (One-Page-Layout).
	if.isTrue.field = sectionIndex
}
