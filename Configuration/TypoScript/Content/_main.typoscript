@import 'EXT:t3sbootstrap/Configuration/TypoScript/Content/Content.typoscript'

tt_content.stdWrap.prepend = TEXT
tt_content.stdWrap.prepend {
	field = tx_t3sbootstrap_anchor
	# SlugHelper falls back to "default-<md5>" when the element has no header
	# (SlugHelper::generate()). Nothing can link to that, so it is dropped here -
	# the nested stdWrap runs before "required".
	stdWrap.replacement.10 {
		search = /^default-[0-9a-f]{32}$/
		replace =
		useRegExp = 1
	}
	required = 1
	htmlSpecialChars = 1
	wrap = <span id="|" class="t3sbs-anchor"></span>
	# Only one condition: the element must be in the section index.
	#
	# Do NOT test the extension option "Speaking ID" here: it only decides whether the
	# field tx_t3sbootstrap_anchor is offered in the backend (see
	# TCA/Overrides/tt_content_newCType.php). The field is old, the option new and off
	# by default - tying rendering to it strips the anchor spans from existing pages
	# while the section menu still links to them (broken in 5.3.51, onepage layout).
	if.isTrue.field = sectionIndex
}
