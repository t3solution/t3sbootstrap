<T3DataStructure>
	<sheets>
		<general>
			<ROOT>
				<sheetTitle>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.general</sheetTitle>
				<type>array</type>
				<el>
					<multipleToast>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.multipleToast</label>
						<onChange>reload</onChange>
						<description>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.multipleToast.description</description>
						<config>
							<type>check</type>
							<default>0</default>
						</config>
					</multipleToast>
					<animation>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.animation</label>
						<displayCond>FIELD:general.multipleToast:=:0</displayCond>
						<config>
							<type>check</type>
							<default>1</default>
						</config>
					</animation>
					<autohide>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.autohide</label>
						<onChange>reload</onChange>
						<displayCond>FIELD:general.multipleToast:=:0</displayCond>
						<config>
							<type>check</type>
							<default>1</default>
						</config>
					</autohide>
					<delay>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.delay</label>
						<displayCond>
							<and>
								<value1>FIELD:general.multipleToast:=:0</value1>
								<and>
									<value1>FIELD:general.autohide:=:1</value1>
								</and>
							</and>
						</displayCond>
						<config>
							<type>number</type>
							<size>5</size>
							<default>5000</default>
						</config>
					</delay>
					<placement>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.placement</label>
						<config>
							<type>select</type>
							<renderType>selectSingle</renderType>
							<items>
								<numIndex index="0">
									<label>default</label>
									<value>top-0 start-50 translate-middle-x</value>
								</numIndex>
								<numIndex index="1">
									<label>Top left</label>
									<value>top-0 start-0</value>
								</numIndex>
								<numIndex index="2">
									<label>Top center</label>
									<value>top-0 start-50 translate-middle-x</value>
								</numIndex>
								<numIndex index="3">
									<label>Top right</label>
									<value>top-0 end-0</value>
								</numIndex>

								<numIndex index="4">
									<label>Middle left</label>
									<value>top-50 start-0 translate-middle-y</value>
								</numIndex>
								<numIndex index="5">
									<label>Middle center</label>
									<value>top-50 start-50 translate-middle</value>
								</numIndex>
								<numIndex index="6">
									<label>Middle right</label>
									<value>top-50 end-0 translate-middle-y</value>
								</numIndex>

								<numIndex index="7">
									<label>Bottom left</label>
									<value>bottom-0 start-0</value>
								</numIndex>
								<numIndex index="8">
									<label>Bottom center</label>
									<value>bottom-0 start-50 translate-middle-x</value>
								</numIndex>
								<numIndex index="9">
									<label>Bottom right</label>
									<value>bottom-0 end-0</value>
								</numIndex>

							</items>
							<default>top-0 start-50 translate-middle-x</default>
						</config>
					</placement>
					<toastwidth>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.toastwidth</label>
						<displayCond>FIELD:general.multipleToast:=:0</displayCond>
						<config>
							<type>number</type>
							<size>5</size>
							<default>350</default>
						</config>
					</toastwidth>
					<cookie>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.cookie</label>
						<displayCond>FIELD:general.multipleToast:=:0</displayCond>
						<description>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.cookie.description</description>
						<onChange>reload</onChange>
						<config>
							<type>check</type>
							<default>0</default>
						</config>
					</cookie>
					
					<expires>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.cookie.expires</label>
						<displayCond>FIELD:general.cookie:=:1</displayCond>
						<config>
							<type>number</type>
							<size>5</size>
							<default>30</default>
						</config>
					</expires>
				</el>
			</ROOT>
		</general>
	</sheets>
</T3DataStructure>
