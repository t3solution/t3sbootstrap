		<images>
			<ROOT>
				<sheetTitle>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.imgsheet</sheetTitle>
				<type>array</type>
				<el>
					<origImage>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.origImage</label>
						<displayCond>USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</displayCond>
						<onChange>reload</onChange>
						<config>
							<type>check</type>
							<default>0</default>
						</config>
					</origImage>
					<width>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.width</label>
						<displayCond>USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</displayCond>
						<config>
							<type>number</type>
							<size>4</size>
							<max>4</max>
							<default>1296</default>
							<checkbox>0</checkbox>
						</config>
					</width>
					<bgAttachmentFixed>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.bgAttachmentFixed</label>
						<displayCond>
							<AND>
								<numIndex index="0">FIELD:images.origImage:=:0</numIndex>
								<numIndex index="1">USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</numIndex>
							</AND>
						</displayCond>
						<config>
							<type>check</type>
						</config>
					</bgAttachmentFixed>
					<enableAutoheight>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.enableAutoheight</label>
						<onChange>reload</onChange>
						<displayCond>
							<AND>
								<numIndex index="0">FIELD:images.origImage:=:0</numIndex>
								<numIndex index="1">USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</numIndex>
							</AND>
						</displayCond>
						<config>
							<type>check</type>
							<default>0</default>
						</config>
					</enableAutoheight>
					<addHeight>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.addHeight</label>
						<displayCond>
							<AND>
								<numIndex index="0">FIELD:images.enableAutoheight:=:1</numIndex>
								<numIndex index="1">FIELD:images.origImage:=:0</numIndex>
								<numIndex index="2">USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</numIndex>
								<OR>
									<numIndex index="0">FIELD:images.enableAutoheight:=:1</numIndex>
									<numIndex index="1">FIELD:images.origImage:=:1</numIndex>
									<numIndex index="2">USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</numIndex>
								</OR>
							</AND>
						</displayCond>
						<config>
							<type>number</type>
							<checkbox></checkbox>
							<size>6</size>
							<default>60</default>
						</config>
					</addHeight>
					<alignItem>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.alignItem</label>
						<displayCond>
							<AND>
								<numIndex index="2">USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</numIndex>
								<OR>
								 		<numIndex index="0">FIELD:images.enableAutoheight:=:1</numIndex>
								 		<numIndex index="1">FIELD:images.origImage:=:1</numIndex>
								</OR>
							</AND>
						</displayCond>
						<config>
							<type>select</type>
							<renderType>selectSingle</renderType>
							<items>
								<numIndex index="0">
									<label>none</label>
									<value>0</value>
								</numIndex>
								<numIndex index="1">
									<label>start</label>
									<value>align-self-start</value>
								</numIndex>
								<numIndex index="2">
									<label>end</label>
									<value>align-self-end</value>
								</numIndex>
								<numIndex index="3">
									<label>center</label>
									<value>align-self-center</value>
								</numIndex>
								<numIndex index="4">
									<label>baseline</label>
									<value>align-self-baseline</value>
								</numIndex>
								<numIndex index="5">
									<label>stretch</label>
									<value>align-self-stretch</value>
								</numIndex>
							</items>
							<default>align-self-center</default>
						</config>
					</alignItem>
					<paddingTopBottom>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.paddingTopBottom</label>
						<displayCond>
							<AND>
								<numIndex index="0">FIELD:images.enableAutoheight:=:0</numIndex>
								<numIndex index="1">FIELD:images.origImage:=:0</numIndex>
								<numIndex index="2">USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</numIndex>
								<OR>
									<numIndex index="0">FIELD:images.enableAutoheight:=:1</numIndex>
									<numIndex index="1">FIELD:images.origImage:=:0</numIndex>
									<numIndex index="2">USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</numIndex>
								</OR>
							</AND>
						</displayCond>
						<config>
							<type>number</type>
							<checkbox></checkbox>
							<size>6</size>
							<default>1</default>
						</config>
					</paddingTopBottom>
					<imgGrayscale>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.imgGrayscale</label>
						<displayCond>USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</displayCond>
						<config>
							<type>number</type>
							<size>5</size>
							<range>
								<lower>0</lower>
								<upper>100</upper>
							</range>
							<default>0</default>
							<slider>
								<step>1</step>
								<width>200</width>
							</slider>
						</config>
					</imgGrayscale>
					<imgSepia>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.imgSepia</label>
						<displayCond>USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</displayCond>
						<config>
							<type>number</type>
							<size>5</size>
							<default>0</default>
							<range>
								<lower>0</lower>
								<upper>100</upper>
							</range>
							<slider>
								<step>1</step>
								<width>200</width>
							</slider>
						</config>
					</imgSepia>
					<imgOpacity>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.imgOpacity</label>
						<displayCond>USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</displayCond>
						<config>
							<type>number</type>
							<size>5</size>
							<default>100</default>
							<range>
								<lower>0</lower>
								<upper>100</upper>
							</range>
							<slider>
								<step>1</step>
								<width>200</width>
							</slider>
						</config>
					</imgOpacity>
					<imageRaster>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.imageRaster</label>
						<displayCond>USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->isImage</displayCond>
						<config>
							<type>check</type>
							<default>0</default>
						</config>
					</imageRaster>
				</el>
			</ROOT>
		</images>

		<background>
			<ROOT>
				<sheetTitle>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.bgw.sheetNomedia</sheetTitle>
