							<type>select</type>
							<renderType>selectSingle</renderType>
							<items>
								<numIndex index="0">
									<label>none</label>
									<value>none</value>
								</numIndex>
								<numIndex index="1">
									<label>start</label>
									<value>align-self-start</value>
								</numIndex>
								<numIndex index="2">
									<label>end</label>
									<value>align-self-end</value>
								</numIndex>
								<numIndex index="3">
									<label>center</label>
									<value>align-self-center</value>
								</numIndex>
								<numIndex index="4">
									<label>baseline</label>
									<value>align-self-baseline</value>
								</numIndex>
								<numIndex index="5">
									<label>stretch</label>
