<T3DataStructure>
	<sheets>
		<sDEF>
			<ROOT>
				<sheetTitle>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.settings</sheetTitle>
				<type>array</type>
				<el>
					<hidden>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.hidden</label>
						<config>
							<type>select</type>
							<renderType>selectSingle</renderType>
							<items>
								<numIndex index="0">
									<label>none</label>
									<value>0</value>
								</numIndex>
								<numIndex index="1">
									<label>Hidden only on xs</label>
									<value>d-none d-sm-block</value>
								</numIndex>
								<numIndex index="2">
									<label>Hidden on sm and down</label>
									<value>d-none d-md-block</value>
								</numIndex>
								<numIndex index="3">
									<label>Hidden on md and down</label>
									<value>d-none d-lg-block</value>
								</numIndex>
								<numIndex index="4">
									<label>Hidden on lg and down</label>
									<value>d-none d-xl-block</value>
								</numIndex>
								<numIndex index="5">
									<label>Hidden only on xl</label>
									<value>d-xl-none</value>
								</numIndex>
								<numIndex index="6">
									<label>Visible only on xs</label>
									<value>d-block d-sm-none</value>
								</numIndex>
								<numIndex index="7">
									<label>Visible sm and down</label>
									<value>d-block d-md-none</value>
								</numIndex>
								<numIndex index="8">
									<label>Visible md and down</label>
									<value>d-block d-lg-none</value>
								</numIndex>
								<numIndex index="9">
									<label>Visible lg and down</label>
									<value>d-block d-xl-none</value>
								</numIndex>
							</items>
							<default>0</default>
						</config>
					</hidden>
					<colclass>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.colclass</label>
						<description>default: "col-sm-6 col-lg-4 mb-4"</description>
						<config>
							 <type>input</type>
							 <size>40</size>
							 <default>col-sm-6 col-lg-4 mb-4</default>
							 <eval>trim</eval>
						</config>
					</colclass>
					<shuffle>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.masonry.shuffle</label>
						<description>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.masonry.shuffle.description</description>
						<config>
							<type>check</type>
							<renderType>checkboxToggle</renderType>
							<default>0</default>
						</config>
					</shuffle>
					<shuffleCategories>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.masonry.shuffleCategories</label>
						<description>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.masonry.shuffleCategories.description</description>
						<displayCond>FIELD:shuffle:REQ:true</displayCond>
						<config>
							<type>select</type>
							<renderType>selectMultipleSideBySide</renderType>
							<foreign_table>sys_category</foreign_table>
							<foreign_table_where>AND sys_category.sys_language_uid IN (0,-1) ORDER BY sys_category.title</foreign_table_where>
							<size>8</size>
							<autoSizeMax>12</autoSizeMax>
							<maxitems>30</maxitems>
							<enableMultiSelectFilterTextfield>1</enableMultiSelectFilterTextfield>
						</config>
					</shuffleCategories>
					<shuffleLabel>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.masonry.shuffleLabel</label>
						<displayCond>FIELD:shuffle:REQ:true</displayCond>
						<config>
							<type>input</type>
							<size>20</size>
							<default>Filtern</default>
							<eval>trim</eval>
						</config>
					</shuffleLabel>
					<shuffleAllLabel>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.masonry.shuffleAllLabel</label>
						<displayCond>FIELD:shuffle:REQ:true</displayCond>
						<config>
							<type>input</type>
							<size>20</size>
							<default>Alle</default>
							<eval>trim</eval>
						</config>
					</shuffleAllLabel>
				</el>
			</ROOT>
		</sDEF>
	</sheets>
</T3DataStructure>