<T3DataStructure>
	<sheets>
		<general>
			<ROOT>
				<sheetTitle>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.general</sheetTitle>
				<type>array</type>
				<el>
					<hidden>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.hidden</label>
						<config>
							<type>select</type>
							<renderType>selectSingle</renderType>
							<items type="array">
								<numIndex index="0" type="array">
									<label>none</label>
									<value>0</value>
								</numIndex>
								<numIndex index="1" type="array">
									<label>Hidden only on xs</label>
									<value>d-none d-sm-block</value>
								</numIndex>
								<numIndex index="2" type="array">
									<label>Hidden on sm and down</label>
									<value>d-none d-md-block</value>
								</numIndex>
								<numIndex index="3" type="array">
									<label>Hidden on md and down</label>
									<value>d-none d-lg-block</value>
								</numIndex>
								<numIndex index="4" type="array">
									<label>Hidden on lg and down</label>
									<value>d-none d-xl-block</value>
								</numIndex>
								<numIndex index="5" type="array">
									<label>Hidden only on xl</label>
									<value>d-xl-none</value>
								</numIndex>
								<numIndex index="6" type="array">
									<label>Visible only on xs</label>
									<value>d-block d-sm-none</value>
								</numIndex>
								<numIndex index="7" type="array">
									<label>Visible sm and down</label>
									<value>d-block d-md-none</value>
								</numIndex>
								<numIndex index="8" type="array">
									<label>Visible md and down</label>
									<value>d-block d-lg-none</value>
								</numIndex>
								<numIndex index="9" type="array">
									<label>Visible lg and down</label>
									<value>d-block d-xl-none</value>
								</numIndex>
							</items>
							<default>0</default>
						</config>
					</hidden>
					<width>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.width</label>
						<config>
							<type>number</type>
							<size>4</size>
							<max>4</max>
							<default>1440</default>
							<required>true</required>
							<checkbox>0</checkbox>
						</config>
					</width>
					<ratio>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.ratio</label>
						<description>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.ratio.description</description>
						<config>
							<type>input</type>
							<size>4</size>
							<max>5</max>
							<default></default>
							<checkbox>0</checkbox>
						</config>
					</ratio>
					<mobileNoRatio>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.mobilenoratio</label>
						<description>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.mobilenoratio.description</description>
						<config>
							<type>check</type>
						</config>
					</mobileNoRatio>
					<origImage>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.origimage</label>
						<config>
							<type>check</type>
						</config>
					</origImage>
					<thumbnails>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.thumbnails</label>
						<config>
							<type>check</type>
						</config>
					</thumbnails>
					<carouselFade>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.carouselfade</label>
						<config>
							<type>check</type>
						</config>
					</carouselFade>
					<darkVariant>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.darkvariant</label>
						<config>
							<type>check</type>
						</config>
					</darkVariant>
					<interval>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.interval</label>
						<config>
							<type>number</type>
							<size>5</size>
							<max>5</max>
							<default>5000</default>
							<checkbox>0</checkbox>
						</config>
					</interval>
					<link>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.link</label>
						<onChange>reload</onChange>
						<config>
							<type>select</type>
							<renderType>selectSingle</renderType>
							<items type="array">
								<numIndex index="0" type="array">
									<label>Header with link</label>
									<value>header</value>
								</numIndex>
								<numIndex index="1" type="array">
									<label>Button with link</label>
									<value>button</value>
								</numIndex>
							</items>
							<default>header</default>
						</config>
					</link>
					<buttontext>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.buttontext</label>
						<displayCond>FIELD:general.link:=:button</displayCond>
						<config>
							<type>input</type>
							<size>69</size>
							<max>99</max>
							<default></default>
							<checkbox>0</checkbox>
						</config>
					</buttontext>
					<animate>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.animate</label>
						<description>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.animate.description</description>
						<displayCond>USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->animateCss</displayCond>
						<config>
							<type>input</type>
							<checkbox></checkbox>
							<eval>trim</eval>
							<size>20</size>
							<max>99</max>
							<default></default>
							<valuePicker type="array">
								<items type="array">
									<numIndex index="0" type="array">
										<label>fadeIn</label>
										<value>fadeIn</value>
									</numIndex>
									<numIndex index="1" type="array">
										<label>fadeInUpBig</label>
										<value>fadeInUpBig</value>
									</numIndex>
									<numIndex index="2" type="array">
										<label>fadeInDownBig</label>
										<value>fadeInDownBig</value>
									</numIndex>
									<numIndex index="3" type="array">
										<label>rotateIn</label>
										<value>rotateIn</value>
									</numIndex>
									<numIndex index="4" type="array">
										<label>slideInUp</label>
										<value>slideInUp</value>
									</numIndex>
									<numIndex index="5" type="array">
										<label>zoomIn</label>
										<value>zoomIn</value>
									</numIndex>
									<numIndex index="6" type="array">
										<label>zoomInUp</label>
										<value>zoomInUp</value>
									</numIndex>
									<numIndex index="7" type="array">
										<label>zoomInDown</label>
										<value>zoomInDown</value>
									</numIndex>
									
									<numIndex index="8" type="array">
										<label>rubberBand</label>
										<value>rubberBand</value>
									</numIndex>
									<numIndex index="9" type="array">
										<label>rollIn</label>
										<value>rollIn</value>
									</numIndex>
								</items>
							</valuePicker>
						</config>
					</animate>
					<zoom>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.zoom</label>
						<description>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.zoom.description</description>
						<config>
							<type>check</type>
						</config>
					</zoom>
					<mobileIndicators>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.carousel_container.mobileindicators</label>
						<config>
							<type>check</type>
						</config>
					</mobileIndicators>
					
				</el>
			</ROOT>
		</general>
	</sheets>
</T3DataStructure>
