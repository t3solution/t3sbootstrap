<T3DataStructure>
	<meta>
		<langDisable>1</langDisable>
	</meta>
	<sheets>
		<general>
			<ROOT>
				<sheetTitle>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.general</sheetTitle>
				<type>array</type>
				<el>
					<animation>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.animation</label>
						<config>
							<type>check</type>
							<default>1</default>
						</config>
					</animation>
					<autohide>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.autohide</label>
						<onChange>reload</onChange>
						<config>
							<type>check</type>
							<default>1</default>
						</config>
					</autohide>
					<delay>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.delay</label>
						<displayCond>FIELD:general.autohide:=:1</displayCond>
						<config>
							<type>number</type>
							<size>5</size>
							<default>5000</default>
						</config>
					</delay>
					<placement>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.placement</label>
						<displayCond>USER:T3SBS\T3sbootstrap\UserFunction\TcaMatcher->toastContainerParent</displayCond>
						<config>
							<type>select</type>
							<renderType>selectSingle</renderType>
							<items>
								<numIndex index="0">
									<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.placement.item1</label>
									<value>top-0 start-50 translate-middle-x</value>
								</numIndex>
								<numIndex index="1">
									<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.placement.item2</label>
									<value>top-0 start-0</value>
								</numIndex>
								<numIndex index="2">
									<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.placement.item3</label>
									<value>top-0 start-50 translate-middle-x</value>
								</numIndex>
								<numIndex index="3">
									<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.placement.item4</label>
									<value>top-0 end-0</value>
								</numIndex>
								<numIndex index="4">
									<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.placement.item5</label>
									<value>top-50 start-0 translate-middle-y</value>
								</numIndex>
								<numIndex index="5">
									<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.placement.item6</label>
									<value>top-50 start-50 translate-middle</value>
								</numIndex>
								<numIndex index="6">
									<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.placement.item7</label>
									<value>top-50 end-0 translate-middle-y</value>
								</numIndex>

								<numIndex index="7">
									<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.placement.item8</label>
									<value>bottom-0 start-0</value>
								</numIndex>
								<numIndex index="8">
									<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.placement.item9</label>
									<value>bottom-0 start-50 translate-middle-x</value>
								</numIndex>
								<numIndex index="9">
									<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.placement.item10</label>
									<value>bottom-0 end-0</value>
								</numIndex>
							</items>
							<default>top-0 start-50 translate-middle-x</default>
						</config>
					</placement>
					<toastwidth>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.toastwidth</label>
						<config>
							<type>number</type>
							<size>5</size>
							<default>350</default>
						</config>
					</toastwidth>
					<cookie>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.cookie</label>
						<description>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.cookie.description</description>
						<onChange>reload</onChange>
						<config>
							<type>check</type>
							<default>0</default>
						</config>
					</cookie>
					<expires>
						<label>LLL:EXT:t3sbootstrap/Resources/Private/Language/locallang_be.xlf:flexform.t3sbs_toast.cookie.expires</label>
						<displayCond>FIELD:general.cookie:=:1</displayCond>
						<config>
							<type>number</type>
							<size>5</size>
							<default>30</default>
						</config>
					</expires>
				</el>
			</ROOT>
		</general>
	</sheets>
</T3DataStructure>
